// This is your Prisma schema file for local zero-config SQLite development.
// (To deploy to Postgres on Neon/Supabase, change provider to "postgresql" or use schema.postgresql.prisma)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  brand          String
  modelNumber    String
  category       String
  description    String
  images         String   // JSON array of image URLs
  mrp            Int      // in paise (e.g. 13490000 = ₹1,34,900)
  warrantyMonths Int      @default(6)
  returnDays     Int      @default(7)
  units          Unit[]
  reviews        Review[]
  createdAt      DateTime @default(now())
}

model Unit {
  id            String    @id @default(cuid())
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  serialOrImei  String    @unique
  grade         String    // "A_PLUS" | "A" | "B" | "C"
  source        String    // "REFURBISHED" | "OPEN_BOX" | "REPAIRED" | "PREOWNED"
  costPaise     Int       // cost + repair in paise
  repairNotes   String?   // e.g. "Screen replaced (OEM Grade A), battery at 92%"
  repairPhotos  String?   // JSON array of photos of repair/diagnostic
  batteryHealth Int?      // e.g. 92
  pricePaise    Int       // listing price in paise
  floorPaise    Int       // minimum margin floor price in paise
  status        String    @default("AVAILABLE") // "AVAILABLE" | "RESERVED" | "SOLD"
  reservedUntil DateTime?
  order         Order?
  createdAt     DateTime  @default(now())
}

model Order {
  id             String    @id @default(cuid())
  userId         String    @default("guest")
  unitId         String    @unique
  unit           Unit      @relation(fields: [unitId], references: [id])
  amountPaise    Int
  couponCode     String?
  discountPaise  Int       @default(0)
  status         String    @default("AWAITING_PAYMENT") // AWAITING_PAYMENT, PAYMENT_SUBMITTED, VERIFIED, REJECTED, PAID, FAILED, SHIPPED, DELIVERED, CANCELLED, REFUNDED
  paymentMode    String    @default("MANUAL_UPI")       // "MANUAL_UPI" | "RAZORPAY"
  rzpOrderId     String?   @unique
  rzpPaymentId   String?
  utr            String?   @unique
  utrSubmittedAt DateTime?
  payerName      String?
  screenshotUrl  String?
  verifiedBy     String?
  verifiedAt     DateTime?
  rejectReason   String?
  shippingJson   String    // JSON string containing name, phone, address, city, state, pincode
  invoiceNo      String?   @unique
  createdAt      DateTime  @default(now())
}

model Coupon {
  code       String  @id
  percentOff Int
  maxUses    Int
  used       Int     @default(0)
  active     Boolean @default(true)
}

model Review {
  id               String   @id @default(cuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userName         String
  rating           Int      @default(5)
  comment          String
  verifiedPurchase Boolean  @default(true)
  createdAt        DateTime @default(now())
}
